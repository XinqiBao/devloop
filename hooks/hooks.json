{
  "description": "Inject the devloop engineering defaults when a session starts, resumes, clears, compacts, or forks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/inject-core.sh"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
