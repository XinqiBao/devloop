[Unit]
Description=devloop - AI autonomous development cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agent
WorkingDirectory=/home/agent/devloop
ExecStart=/usr/bin/python3 -m src.scheduler --once
Environment=HOME=/home/agent
EnvironmentFile=/home/agent/.config/devloop/env
TimeoutStartSec=3900
StandardOutput=append:/var/log/devloop/cycle.log
StandardError=append:/var/log/devloop/cycle.log
